HOST=0.0.0.0
PORT=8000
RELOAD=true
# Leave empty for automatic LAN IP / mDNS address selection.
PUBLIC_BASE_URL=
PHONE_CAMERA_HOSTNAME=industrial-safety.local
ENABLE_MDNS=true
# Optional overrides. run.py automatically uses generated files under certs/.
SSL_CERTFILE=
SSL_KEYFILE=
CAMERA_SESSION_TTL_SECONDS=300
STUN_URL=stun:stun.l.google.com:19302
