HOST=0.0.0.0
PORT=8000
RELOAD=false
# Leave empty for automatic LAN IP / mDNS address selection.
PUBLIC_BASE_URL=
PHONE_CAMERA_HOSTNAME=industrial-safety.local
ENABLE_MDNS=true
# Optional overrides. run.py automatically uses generated files under certs/.
SSL_CERTFILE=
SSL_KEYFILE=
CAMERA_SESSION_TTL_SECONDS=300
STUN_URL=stun:stun.l.google.com:19302
# RTC_ICE_SERVERS_JSON=[{"urls":["turn:turn.example.com:3478"],"username":"user","credential":"secret"}]

# Inference backend: local loads VideoMAE on this machine; remote proxies to Kaggle.
INFERENCE_BACKEND=local
REMOTE_INFERENCE_URL=
REMOTE_INFERENCE_TOKEN=
REMOTE_INFERENCE_TIMEOUT_SECONDS=180
REMOTE_LIVE_TIMEOUT_SECONDS=20
POSE_TRACKING_ENABLED=true
POSE_AUTO_START=true
POSE_SERVICE_WS_URL=ws://127.0.0.1:8001/ws/pose
POSE_SERVICE_HTTP_URL=http://127.0.0.1:8001
POSE_VIDEO_TIMEOUT_SECONDS=600
POSE_MODEL=yolo26n-pose.pt
POSE_TRACKER=bytetrack.yaml
POSE_DEVICE=cpu
POSE_IMAGE_SIZE=640
POSE_CONFIDENCE=0.35
POSE_VIDEO_FPS=10
